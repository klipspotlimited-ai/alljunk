<!doctype html>
<html class="touch-styles"{.if authenticatedAccount} data-authenticated-account{.end} lang="en-GB">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {.if collection.homepage}
      <title>Rubbish Removal Bromley, Kent &amp; SE London | All Junk Solutions</title>
      <meta name="description" content="Licensed rubbish removal, house clearances and shed demolition in Bromley, Kent &amp; SE London. Send photos on WhatsApp to 07931 935 833 for a fast quote.">
    {.or}
      {.equal? collection.urlId "services"}
        <title>Waste &amp; Rubbish Removal Services Bromley | All Junk Solutions</title>
        <meta name="description" content="House clearances, garage &amp; shed demolition, furniture disposal, garden waste and builders waste across Bromley, Kent &amp; SE London. Licensed CBDU195530.">
      {.or}
        {.equal? collection.urlId "pricing"}
          <title>Rubbish Removal Prices Bromley &amp; Kent | All Junk Solutions</title>
          <meta name="description" content="Clear rubbish removal load prices from £125 to £425 (minimum charge from £40). Loading, sweep-up, parking and congestion included. Fast WhatsApp quotes.">
        {.or}
          {.equal? collection.urlId "testimonials"}
            <title>Customer Reviews | 5.0★ Rubbish Removal Bromley | All Junk</title>
            <meta name="description" content="Read 90+ 5.0-star customer reviews for All Junk Solutions across Bromley, Kent and South East London. Fast arrivals, fair photo quotes and tidy clearances.">
          {.or}
            {.equal? collection.urlId "media"}
              <title>Before &amp; After Clearances &amp; Shed Demolition | All Junk</title>
              <meta name="description" content="See real before-and-after house clearances, garden waste collections and garage &amp; shed demolitions across Bromley, Kent and South East London.">
            {.or}
              {.equal? collection.urlId "about-us"}
                <title>Areas Covered: Bromley, Kent &amp; SE London | All Junk Solutions</title>
                <meta name="description" content="Bromley-based licensed waste carrier (CBDU195530) serving Bromley, Beckenham, Orpington, Chislehurst, Kent and South East London since 2017.">
              {.or}
                {.equal? collection.urlId "contact"}
                  <title>Contact &amp; Fast WhatsApp Quote | All Junk Solutions Bromley</title>
                  <meta name="description" content="Send photos of your rubbish and your postcode on WhatsApp to 07931 935 833 for a fast, fixed-price clearance quote across Bromley, Kent &amp; SE London.">
                {.or}
                  {.equal? collection.urlId "house-clearance-bromley"}
                    <title>House Clearance in Bromley | Licensed Team | All Junk Solutions</title>
                    <meta name="description" content="Licensed house, loft, garage and probate clearances in Bromley, Beckenham and Orpington. Clear load prices, £30 single mattress disposal, fast WhatsApp photo quotes.">
                  {.or}
                    {.equal? collection.urlId "garage-shed-demolition-bromley"}
                      <title>Garage &amp; Shed Demolition in Bromley | All Junk Solutions</title>
                      <meta name="description" content="Safe garage, shed and small outbuilding demolition in Bromley, Beckenham and Orpington. Structure taken down, waste loaded and cleared. Send photos on WhatsApp.">
                    {.or}
                      <title>Rubbish Removal Bromley, Kent &amp; SE London | All Junk Solutions</title>
                      <meta name="description" content="Licensed rubbish removal, house clearances and shed demolition in Bromley, Kent &amp; SE London. Send photos on WhatsApp to 07931 935 833 for a fast quote.">
                    {.end}
                  {.end}
                {.end}
              {.end}
            {.end}
          {.end}
        {.end}
      {.end}
    {.end}
    <meta property="og:image" content="https://www.alljunksolutions.co.uk/assets/all-junk-social-preview.jpg">
    <meta property="og:image:secure_url" content="https://www.alljunksolutions.co.uk/assets/all-junk-social-preview.jpg">
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="All Junk Solutions - Rubbish Removal Made Easy">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="https://www.alljunksolutions.co.uk/assets/all-junk-social-preview.jpg">
    <link rel="icon" href="/assets/favicon.ico" sizes="any">
    <link rel="preload" href="/assets/google-sans-flex.woff2" as="font" type="font/woff2" crossorigin>
    {.if collection.homepage}
    <link rel="preload" href="/assets/all-junk-van-slider-800.webp" as="image" imagesrcset="/assets/all-junk-van-slider-480.webp 480w, /assets/all-junk-van-slider-800.webp 800w, /assets/all-junk-van-slider.webp 1320w" imagesizes="100vw" fetchpriority="high">
    {.end}
    {squarespace-headers}
    <link rel="stylesheet" href="/assets/alljunk.css?v=20261125b">
    {@|apply alljunk-schema.block}
  </head>
  <body id="{squarespace.page-id}" class="{squarespace.page-classes} alljunk-site-body">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="trust-strip">
      <div class="wrap">
        <span class="trust-primary">Environment Agency registered: CBDU195530</span>
        <span class="trust-secondary">Bromley, Kent &amp; South East London</span>
        <span class="trust-secondary">Mon-Fri 7am-6pm, Sat 7am-3pm</span>
      </div>
    </div>

    <!-- GLOBAL ALL JUNK HEADER -->
    {@|apply alljunk-header.block}

    <!-- MULTIPAGE CONTENT ROUTING -->
    {.if collection.homepage}
      {@|apply alljunk-landing-content.block}
    {.or}
      {.equal? collection.urlId "home"}
        {@|apply alljunk-landing-content.block}
      {.or}
        {.equal? collection.urlId "home-1"}
          {@|apply alljunk-landing-content.block}
        {.or}
          {.equal? collection.urlId "services"}
            {@|apply alljunk-services-page.block}
          {.or}
            {.equal? collection.urlId "pricing"}
              {@|apply alljunk-pricing-page.block}
            {.or}
              {.equal? collection.urlId "testimonials"}
                {@|apply alljunk-reviews-page.block}
              {.or}
                {.equal? collection.urlId "reviews"}
                  {@|apply alljunk-reviews-page.block}
                {.or}
                  {.equal? collection.urlId "media"}
                    {@|apply alljunk-media-page.block}
                  {.or}
                    {.equal? collection.urlId "about-us"}
                      {@|apply alljunk-about-page.block}
                    {.or}
                      {.equal? collection.urlId "contact"}
                        {@|apply alljunk-contact-page.block}
                      {.or}
                        {.equal? collection.urlId "house-clearance-bromley"}
                          {@|apply alljunk-house-clearance-bromley.block}
                        {.or}
                          {.equal? collection.urlId "garage-shed-demolition-bromley"}
                            {@|apply alljunk-garage-shed-demolition-bromley.block}
                          {.or}
                            {.equal? collection.urlId "rubbish-removal-bromley"}
                              {@|apply alljunk-about-page.block}
                            {.or}
                              {.equal? collection.urlId "rubbish-removal-kent"}
                                {@|apply alljunk-about-page.block}
                              {.or}
                                {.equal? collection.urlId "rubbish-removal-south-east-london"}
                                  {@|apply alljunk-about-page.block}
                                {.or}
                                  {squarespace.main-content}
                                {.end}
                              {.end}
                            {.end}
                          {.end}
                        {.end}
                      {.end}
                    {.end}
                  {.end}
                {.end}
              {.end}
            {.end}
          {.end}
        {.end}
      {.end}
    {.end}

    <!-- GLOBAL ALL JUNK FOOTER -->
    {@|apply alljunk-footer.block}

    <!-- INTERACTIVE JAVASCRIPT -->
    <script src="/assets/alljunk.js?v=20261125b" defer></script>
    {squarespace-footers}
  </body>
</html>
