<!doctype html>
<html class="touch-styles"{.if authenticatedAccount} data-authenticated-account{.end} lang="en-GB">
  <head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="/assets/favicon.ico" sizes="any">
    <link rel="preload" href="/assets/google-sans-flex.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/all-junk-van-slider.webp" as="image" imagesrcset="/assets/all-junk-van-slider-800.webp 800w, /assets/all-junk-van-slider.webp 1320w" imagesizes="100vw" fetchpriority="high">
    {squarespace-headers}
    <link rel="stylesheet" href="/assets/alljunk.css">
    {@|apply alljunk-schema.block}
  </head>
  <body id="{squarespace.page-id}" class="{squarespace.page-classes} alljunk-site-body">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="trust-strip">
      <div class="wrap">
        <span class="trust-primary">Environment Agency registered: CBDU195530</span>
        <span class="trust-secondary">Bromley, Kent &amp; South East London</span>
        <span class="trust-secondary">Mon-Fri 7am-6pm, Sat 7am-3pm</span>
      </div>
    </div>

    <!-- GLOBAL ALL JUNK HEADER -->
    {@|apply alljunk-header.block}

    <!-- CONTENT ROUTING -->
    {.if collection.homepage}
      {@|apply alljunk-landing-content.block}
    {.or}
      {.equal? collection.urlId "home"}
        {@|apply alljunk-landing-content.block}
      {.or}
        {.equal? collection.urlId "home-1"}
          {@|apply alljunk-landing-content.block}
        {.or}
          {.equal? collection.urlId "rubbish-removal-bromley"}
            <link rel="stylesheet" href="/assets/location-pages.css">
            {@|apply alljunk-location-content.block}
          {.or}
            {.equal? collection.urlId "rubbish-removal-kent"}
              <link rel="stylesheet" href="/assets/location-pages.css">
              {@|apply alljunk-location-content.block}
            {.or}
              {.equal? collection.urlId "rubbish-removal-south-east-london"}
                <link rel="stylesheet" href="/assets/location-pages.css">
                {@|apply alljunk-location-content.block}
              {.or}
                <!-- SUBPAGES & CMS COLLECTIONS -->
                <main id="main" class="alljunk-subpage-main">
                  <section class="subpage-hero" style="background:#071d49;color:#fff;padding:64px 0 54px;position:relative;overflow:hidden;">
                    <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(7,29,73,.88),rgba(7,29,73,.55)),url('/assets/all-junk-van-street.webp') center/cover no-repeat;opacity:0.6;"></div>
                    <div class="wrap" style="position:relative;z-index:2;">
                      <nav class="crumbs" style="font-size:14px;margin-bottom:14px;color:#dfe9ff;">
                        <a href="/" style="color:#dfe9ff;text-decoration:none;">Home</a> / {.section collection}{title}{.end}
                      </nav>
                      <div style="color:#8dc63f;text-transform:uppercase;letter-spacing:.09em;font-size:13px;font-weight:900;margin-bottom:8px;">All Junk Solutions</div>
                      <h1 style="font-size:clamp(36px,5vw,56px);margin:0 0 16px;line-height:1.05;letter-spacing:-.02em;color:#fff;">
                        {.section collection}{title}{.or}{squarespace.page-title}{.end}
                      </h1>
                      <p style="font-size:19px;max-width:700px;margin:0;color:#dfe9ff;">
                        Licensed waste collection and rubbish removal across Bromley, Kent, and South East London.
                      </p>
                      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:24px;">
                        <a class="btn btn-primary" href="https://wa.me/447931935833?text=Hi%20All%20Junk%20Solutions%2C%20I%27d%20like%20a%20quote" rel="noopener" target="_blank" style="background:#8dc63f;color:#010080;padding:12px 24px;border-radius:8px;font-weight:900;text-decoration:none;">WhatsApp Quote</a>
                        <a class="btn" href="tel:+447931935833" style="background:#fff;color:#010080;padding:12px 24px;border-radius:8px;font-weight:900;text-decoration:none;">Call 07931 935 833</a>
                      </div>
                    </div>
                  </section>

                  <!-- CMS PAGE CONTENT -->
                  <section class="section" style="padding:60px 0;background:#fff;">
                    <div class="wrap" style="min-height:300px;">
                      {squarespace.main-content}
                      <squarespace:block-field id="page-blocks-{collection.id}" columns="12" />
                    </div>
                  </section>
                </main>
              {.end}
            {.end}
          {.end}
        {.end}
      {.end}
    {.end}

    <!-- GLOBAL ALL JUNK FOOTER -->
    {@|apply alljunk-footer.block}

    <!-- INTERACTIVE JAVASCRIPT -->
    <script src="/assets/alljunk.js" defer></script>
    {squarespace-footers}
  </body>
</html>
